# ================================================================
# CLOUD LIBRARY ENVIRONMENT CONFIGURATION
# Local development and GCP Separate VM Instances Reference
# ================================================================

# --- Shared Secret for JWT (Tokens signed by Python, verified by Node/TS) ---
JWT_SECRET=super-secret-library-jwt-key-change-in-prod

# --- Service 1: Catalog Service (Go) ---
# On GCP: point DB_HOST to Cloud SQL MySQL instance or Catalog DB VM internal IP
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=3306
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass
CATALOG_DB_NAME=catalog_db

# --- Service 2: Auth Service (FastAPI / Python) ---
# On GCP: point DB_HOST to Cloud SQL PostgreSQL instance or Auth DB VM internal IP
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db

# --- Service 3: Circulation Service (Node.js / TypeScript) ---
# On GCP: point DB_HOST to Circulation MySQL DB VM internal IP
CIRCULATION_DB_HOST=circulation-db
CIRCULATION_DB_PORT=3306
CIRCULATION_DB_USER=circulation_user
CIRCULATION_DB_PASSWORD=circulation_pass
CIRCULATION_DB_NAME=circulation_db
# In multi-VM setup on GCP: set to http://<CATALOG_VM_INTERNAL_IP>:8081
CATALOG_SERVICE_URL=http://catalog-service:8081

# --- API Gateway (Nginx) ---
# In multi-VM setup on GCP: set to private VPC internal IPs of each VM
GATEWAY_CATALOG_HOST=catalog-service
GATEWAY_CATALOG_PORT=8081
GATEWAY_AUTH_HOST=auth-service
GATEWAY_AUTH_PORT=8000
GATEWAY_CIRCULATION_HOST=circulation-service
GATEWAY_CIRCULATION_PORT=8082
GATEWAY_FRONTEND_HOST=frontend
GATEWAY_FRONTEND_PORT=3000

# --- Frontend (Next.js) ---
# When accessing through Nginx Gateway, leave blank (relative /api)
NEXT_PUBLIC_API_URL=
